  return new Intl.NumberFormat('tr-TR', {
    style: 'currency',
    currency: 'TRY'
  }).format(amount)
}
```

### Tarih Formatı
```typescript
const formatDate = (date: string) => {
  return new Date(date).toLocaleDateString('tr-TR')
}

const formatDateTime = (date: string) => {
  return new Date(date).toLocaleString('tr-TR')
}
```

