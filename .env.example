# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/attelia_dental?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-this-in-production"
NEXTAUTH_SECRET="your-nextauth-secret-key-change-this"
NEXTAUTH_URL="http://localhost:3000"

# Email Configuration
# Choose ONE of the following configurations

# Option 1: Gmail (Recommended for development)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="your-email@gmail.com"

# Option 2: SendGrid (Recommended for production)
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"
# SMTP_FROM="noreply@yourdomain.com"

# Option 3: Custom SMTP Server
# SMTP_HOST="smtp.yourdomain.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="noreply@yourdomain.com"

# File Storage (Vercel Blob)
# Get token from: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token-get-from-vercel-dashboard"

# Application Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Prisma Configuration
# Uncomment if needed
# PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1

# ====================
# PRODUCTION SETUP
# ====================
# For production deployment, make sure to:
# 1. Use strong, unique values for JWT_SECRET and NEXTAUTH_SECRET (min 32 chars)
# 2. Set NEXTAUTH_URL to your production domain
# 3. Use SendGrid or a reliable SMTP service for email
# 4. Create a Vercel Blob store and get the token
# 5. Set NODE_ENV to "production"
# 6. Update NEXT_PUBLIC_APP_URL to your production domain

# ====================
# GMAIL SETUP GUIDE
# ====================
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Select "Mail" and "Other (Custom name)"
# 3. Generate password
# 4. Copy the 16-character password to SMTP_PASS

# ====================
# SENDGRID SETUP GUIDE
# ====================
# 1. Sign up at: https://sendgrid.com
# 2. Go to Settings → API Keys
# 3. Create API Key with "Mail Send" permission
# 4. Copy API key to SMTP_PASS
# 5. Set SMTP_USER to "apikey" (literal string)

# ====================
# VERCEL BLOB SETUP
# ====================
# 1. Go to: https://vercel.com/dashboard
# 2. Navigate to Storage tab
# 3. Click "Create" → "Blob"
# 4. Name your store (e.g., "attelia-files")
# 5. Copy the token to BLOB_READ_WRITE_TOKEN
