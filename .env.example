# ============================================
# Attelia Dental E-Commerce - Environment Variables
# ============================================

# ============================================
# DATABASE CONFIGURATION (Required)
# ============================================
# PostgreSQL database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Production: Add ?sslmode=require for secure connections
DATABASE_URL="postgresql://user:password@localhost:5432/attelia_dental"

# ============================================
# AUTHENTICATION (Required)
# ============================================
# NextAuth.js configuration
# Production URL: https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
# IMPORTANT: Use strong random secrets in production
NEXTAUTH_SECRET="your-secret-key-here"

# JWT secret key (should be different from NEXTAUTH_SECRET)
# Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-here"

# ============================================
# APPLICATION CONFIGURATION (Required)
# ============================================
# Public variables (NEXT_PUBLIC_ prefix required for client-side access)
NEXT_PUBLIC_APP_NAME="Attelia Dental"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# EMAIL CONFIGURATION (Required for Notifications)
# ============================================
# For Gmail: Use App Password (not regular password)
# https://support.google.com/accounts/answer/185833
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"  # true for port 465, false for port 587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
EMAIL_FROM="noreply@satinalma.com"
EMAIL_FROM_NAME="Satın Alma Platformu"

# Alternative: SendGrid (recommended for production)
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASSWORD="your-sendgrid-api-key"

# ============================================
# PAYMENT GATEWAY (Optional)
# ============================================
# PAYMENT_GATEWAY_API_KEY=""
# PAYMENT_GATEWAY_SECRET=""

# ============================================
# FILE STORAGE (Optional)
# ============================================
# AWS S3 or Cloudinary for product images
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""

# ============================================
# NOTES FOR PRODUCTION
# ============================================
# 1. Generate new secrets: openssl rand -base64 32
# 2. Update all URLs to production domain
# 3. Add ?sslmode=require to DATABASE_URL
# 4. Never commit .env file to git
# 5. Set variables in Vercel Project Settings
