# ============================================
# Multi-Tenant Procurement Platform - Environment Variables
# ============================================

# ============================================
# DATABASE CONFIGURATION (Required)
# ============================================
# PostgreSQL database connection string
#
# LOCAL DEVELOPMENT:
# DATABASE_URL="postgresql://user:password@localhost:5432/procurement_db"
#
# VERCEL POSTGRES (Production/Preview):
# Automatically provided by Vercel when you connect Vercel Postgres
# Format: postgres://default:***@***-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require
# Set this in Vercel Dashboard → Project → Settings → Environment Variables
#
# IMPORTANT: Use connection pooling URL for serverless environments
DATABASE_URL="postgresql://user:password@localhost:5432/procurement_db"

# Direct database URL (without pooling) - required for Prisma migrations
# Vercel provides this as POSTGRES_URL_NON_POOLING
# Only needed for running migrations: npx prisma migrate deploy
DIRECT_URL=""

# ============================================
# AUTHENTICATION (Required)
# ============================================
# NextAuth.js configuration
# Production URL: https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
# IMPORTANT: Use strong random secrets in production
NEXTAUTH_SECRET="your-secret-key-here"

# JWT secret key (should be different from NEXTAUTH_SECRET)
# Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-here"

# ============================================
# APPLICATION CONFIGURATION (Required)
# ============================================
# Public variables (NEXT_PUBLIC_ prefix required for client-side access)
NEXT_PUBLIC_APP_NAME="Procurement Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# DEMO TENANT CONFIGURATION (Optional)
# ============================================
# Enable/disable demo tenant provisioning from login screen
ENABLE_DEMO_TENANTS="true"

# Demo tenant auto-cleanup period in days
DEMO_CLEANUP_DAYS="7"

# CRON secret for Vercel Cron jobs (secure the cleanup endpoint)
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-specific-password"
# EMAIL_FROM="noreply@attelia.com"

# ============================================
# PAYMENT GATEWAY (Optional)
# ============================================
# PAYMENT_GATEWAY_API_KEY=""
# PAYMENT_GATEWAY_SECRET=""

# ============================================
# FILE STORAGE (Optional)
# ============================================
# AWS S3 or Cloudinary for product images
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""

# ============================================
# NOTES FOR PRODUCTION
# ============================================
# 1. Generate new secrets: openssl rand -base64 32
# 2. Update all URLs to production domain
# 3. Add ?sslmode=require to DATABASE_URL
# 4. Never commit .env file to git
# 5. Set variables in Vercel Project Settings
