// Attelia Dental Multi-Tenant E-commerce Database Schema
// Comprehensive Database Design with Full Business Logic

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE MODELS - Company & User Management
// ============================================

// Şirket/Organizasyon Modeli (Multi-tenant)
model Company {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  taxNumber     String?   @unique
  address       String?
  city          String?
  phone         String?
  email         String?
  website       String?
  logo          String?
  isActive      Boolean   @default(true)
  settings      Json?

  // Subscription info
  plan          String?   @default("free") // free, basic, premium, enterprise
  planExpiry    DateTime?
  maxUsers      Int       @default(5)
  maxProducts   Int       @default(100)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users                 User[]
  departments           Department[]
  categories            Category[]
  products              Product[]
  orders                Order[]
  purchaseRequests      PurchaseRequest[]
  workflows             ApprovalWorkflow[]
  companyBudgets        CompanyBudget[]
  purchaseCategories    PurchaseCategory[]
  suppliers             Supplier[]
  coupons               Coupon[]
  documents             Document[]
  addresses             Address[]
  paymentMethods        PaymentMethod[]
  notifications         Notification[]

  @@index([slug])
  @@index([isActive])
}

// Kullanıcı Modeli
model User {
  id            String    @id @default(cuid())
  email         String
  name          String
  password      String
  phone         String?
  avatar        String?
  role          UserRole  @default(EMPLOYEE)

  // Multi-tenant
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Departman bilgileri
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  position      String?
  employeeId    String?

  // Kimlik bilgileri
  identityNumber String?
  birthDate     DateTime?
  hireDate      DateTime?

  // İletişim
  address       String?
  city          String?
  district      String?
  postalCode    String?

  // Güvenlik
  isActive      Boolean   @default(true)
  isEmailVerified Boolean @default(false)
  emailVerifiedAt DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?

  // Bildirim tercihleri
  notificationPreferences Json?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders                Order[]
  cart                  CartItem[]
  reviews               Review[]
  purchaseRequests      PurchaseRequest[]
  approvalActions       ApprovalAction[]
  managedDepartments    Department[] @relation("DepartmentManager")
  userBudgets           UserBudget[]
  addresses             Address[]
  activityLogs          ActivityLog[]
  sentNotifications     Notification[]
  documents             Document[]
  paymentTransactions   PaymentTransaction[]

  @@unique([email, companyId])
  @@index([email])
  @@index([companyId])
  @@index([departmentId])
  @@index([employeeId])
  @@index([isActive])
}

enum UserRole {
  SUPER_ADMIN        // Platform admin
  COMPANY_ADMIN      // Şirket admin'i
  EMPLOYEE
  DEPARTMENT_MANAGER
  FINANCE_MANAGER
  GENERAL_MANAGER
  PROCUREMENT_MANAGER
}

// ============================================
// ORGANIZATION STRUCTURE
// ============================================

// Departman Modeli
model Department {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String
  code            String
  description     String?
  managerId       String?
  manager         User?     @relation("DepartmentManager", fields: [managerId], references: [id])
  parentId        String?
  parent          Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children        Department[] @relation("DepartmentHierarchy")

  // Bütçe
  budget          Decimal?  @db.Decimal(12, 2)
  monthlyBudget   Decimal?  @db.Decimal(12, 2)
  yearlyBudget    Decimal?  @db.Decimal(12, 2)

  // İletişim
  email           String?
  phone           String?
  location        String?

  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employees           User[]
  purchaseRequests    PurchaseRequest[]
  budgets             Budget[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([code])
  @@index([managerId])
  @@index([isActive])
}

// ============================================
// BUDGET MANAGEMENT
// ============================================

// Bütçe Yönetimi - Departman Bazlı
model Budget {
  id              String      @id @default(cuid())
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  year            Int
  month           Int?
  amount          Decimal     @db.Decimal(12, 2)
  spent           Decimal     @db.Decimal(12, 2) @default(0)
  reserved        Decimal     @db.Decimal(12, 2) @default(0)
  available       Decimal     @db.Decimal(12, 2) @default(0)
  notes           String?

  // Tracking
  lastUpdated     DateTime    @default(now())

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([departmentId, year, month])
  @@index([departmentId])
  @@index([year])
  @@index([month])
}

// Şirket Bazlı Bütçe
model CompanyBudget {
  id              String      @id @default(cuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year            Int
  month           Int?
  amount          Decimal     @db.Decimal(12, 2)
  spent           Decimal     @db.Decimal(12, 2) @default(0)
  reserved        Decimal     @db.Decimal(12, 2) @default(0)
  available       Decimal     @db.Decimal(12, 2) @default(0)
  notes           String?
  category        String?     // Genel, IT, Operasyonel, vs.

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([companyId, year, month, category])
  @@index([companyId])
  @@index([year])
}

// Kullanıcı/Kişi Bazlı Bütçe
model UserBudget {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  year            Int
  month           Int?
  amount          Decimal     @db.Decimal(12, 2)
  spent           Decimal     @db.Decimal(12, 2) @default(0)
  reserved        Decimal     @db.Decimal(12, 2) @default(0)
  available       Decimal     @db.Decimal(12, 2) @default(0)
  notes           String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, year, month])
  @@index([userId])
  @@index([year])
}

// ============================================
// CATEGORY & PRODUCT MANAGEMENT
// ============================================

// Satın Alım Kategori Tanımlamaları (Hiyerarşik)
model PurchaseCategory {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String
  code            String
  description     String?
  parentId        String?
  parent          PurchaseCategory?   @relation("PurchaseCategoryHierarchy", fields: [parentId], references: [id])
  children        PurchaseCategory[]  @relation("PurchaseCategoryHierarchy")

  // Bütçe limitleri
  monthlyLimit    Decimal?            @db.Decimal(12, 2)
  yearlyLimit     Decimal?            @db.Decimal(12, 2)

  // Onay gereksinimleri
  requiresApproval Boolean            @default(true)
  minApprovalAmount Decimal?          @db.Decimal(12, 2)

  isActive        Boolean             @default(true)
  order           Int                 @default(0)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  purchaseRequests PurchaseRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([code])
  @@index([parentId])
}

// Kategori Modeli (Ürün Kategorileri)
model Category {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  image       String?
  icon        String?
  color       String?
  parentId    String?
  parent      Category? @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]
  order       Int       @default(0)
  isActive    Boolean   @default(true)

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([slug])
  @@index([parentId])
  @@index([isActive])
}

// Ürün Modeli
model Product {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String
  slug            String
  description     String?
  shortDesc       String?
  sku             String
  barcode         String?

  // Fiyatlandırma
  price           Decimal       @db.Decimal(10, 2)
  costPrice       Decimal?      @db.Decimal(10, 2)
  discountPrice   Decimal?      @db.Decimal(10, 2)
  wholesalePrice  Decimal?      @db.Decimal(10, 2)
  taxRate         Decimal?      @db.Decimal(5, 2) @default(20)

  // Stok
  minOrderQty     Int           @default(1)
  maxOrderQty     Int?
  stock           Int           @default(0)
  lowStockThreshold Int?        @default(10)
  unit            String        @default("adet")

  // Fiziksel özellikler
  weight          Decimal?      @db.Decimal(10, 3)
  length          Decimal?      @db.Decimal(10, 2)
  width           Decimal?      @db.Decimal(10, 2)
  height          Decimal?      @db.Decimal(10, 2)
  dimensions      String?

  // Medya
  images          String[]
  videos          String[]
  documents       String[]

  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])

  supplierId      String?
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])

  brand           String?
  manufacturer    String?
  tags            String[]

  // Durum flags
  isActive        Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  isNew           Boolean       @default(false)
  isOnSale        Boolean       @default(false)
  requiresShipping Boolean      @default(true)

  // İstatistikler
  viewCount       Int           @default(0)
  salesCount      Int           @default(0)
  rating          Decimal?      @db.Decimal(3, 2)
  reviewCount     Int           @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  cartItems             CartItem[]
  orderItems            OrderItem[]
  reviews               Review[]
  purchaseRequestItems  PurchaseRequestItem[]
  priceHistory          PriceHistory[]
  stockMovements        StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([supplierId])
  @@index([isActive])
  @@index([isFeatured])
}

// Fiyat Geçmişi
model PriceHistory {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  oldPrice    Decimal   @db.Decimal(10, 2)
  newPrice    Decimal   @db.Decimal(10, 2)
  changeType  String    // INCREASE, DECREASE, PROMOTION
  reason      String?

  effectiveDate DateTime @default(now())
  createdAt   DateTime  @default(now())

  @@index([productId])
  @@index([effectiveDate])
}

// Stok Hareketleri
model StockMovement {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  type        StockMovementType
  quantity    Int

  // Referanslar
  referenceType String?  // ORDER, PURCHASE_REQUEST, ADJUSTMENT, RETURN
  referenceId   String?

  previousStock Int
  newStock      Int
  notes         String?

  createdBy     String?
  createdAt     DateTime  @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

enum StockMovementType {
  IN           // Giriş
  OUT          // Çıkış
  ADJUSTMENT   // Düzeltme
  RETURN       // İade
  DAMAGED      // Hasarlı
  LOST         // Kayıp
}

// ============================================
// SHOPPING & ORDERS
// ============================================

// Sepet Modeli
model CartItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  price       Decimal?  @db.Decimal(10, 2) // Snapshot of price when added

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

// Sipariş Modeli
model Order {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])

  orderNumber     String
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING)

  // Fatura bilgileri
  billingAddressId String?
  billingAddress   Address?     @relation("BillingAddress", fields: [billingAddressId], references: [id])
  billingName     String
  billingEmail    String
  billingPhone    String
  billingFullAddress String
  billingCity     String
  billingDistrict String
  billingPostal   String?

  // Teslimat bilgileri
  shippingAddressId String?
  shippingAddress   Address?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  shippingName    String
  shippingPhone   String
  shippingFullAddress String
  shippingCity    String
  shippingDistrict String
  shippingPostal  String?

  // Finansal
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingCost    Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  discount        Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)

  // İndirim kuponu
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  couponCode      String?
  couponDiscount  Decimal?      @db.Decimal(10, 2)

  // Ödeme
  paymentMethod   String
  paymentStatus   PaymentStatus @default(PENDING)

  // Notlar ve takip
  customerNotes   String?
  adminNotes      String?
  trackingNumber  String?
  estimatedDelivery DateTime?
  deliveredAt     DateTime?

  // İptal/İade
  cancelledAt     DateTime?
  cancelReason    String?
  refundedAt      DateTime?
  refundAmount    Decimal?      @db.Decimal(10, 2)

  items             OrderItem[]
  purchaseRequest   PurchaseRequest?
  paymentTransactions PaymentTransaction[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Sipariş Ürün Modeli
model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  productName String
  productSku  String
  productImage String?
  quantity    Int
  price       Decimal   @db.Decimal(10, 2)
  tax         Decimal   @db.Decimal(10, 2) @default(0)
  discount    Decimal   @db.Decimal(10, 2) @default(0)
  total       Decimal   @db.Decimal(10, 2)

  notes       String?

  @@index([orderId])
  @@index([productId])
}

// ============================================
// PAYMENT & TRANSACTIONS
// ============================================

// Ödeme İşlemleri
model PaymentTransaction {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])

  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("TRY")
  method          PaymentMethod
  status          PaymentTransactionStatus

  // Gateway bilgileri
  gateway         String?       // iyzico, paytr, stripe, etc.
  gatewayTransactionId String?
  gatewayResponse Json?

  // Kart bilgileri (masked)
  cardLast4       String?
  cardBrand       String?
  cardHolderName  String?

  // IP ve güvenlik
  ipAddress       String?
  userAgent       String?

  failureReason   String?
  notes           String?

  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  CASH
  WALLET
  CRYPTO
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

// Kayıtlı Ödeme Yöntemleri
model PaymentMethod {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  type        String    // card, bank, cash
  isActive    Boolean   @default(true)
  isDefault   Boolean   @default(false)

  // Kart/Banka bilgileri
  cardLast4   String?
  cardBrand   String?
  bankName    String?
  accountNumber String?

  settings    Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([isActive])
}

// ============================================
// COUPON & DISCOUNTS
// ============================================

model Coupon {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code            String
  description     String?

  // İndirim tipi
  discountType    DiscountType
  discountValue   Decimal   @db.Decimal(10, 2)
  maxDiscount     Decimal?  @db.Decimal(10, 2)

  // Kullanım koşulları
  minPurchase     Decimal?  @db.Decimal(10, 2)
  maxUses         Int?
  usedCount       Int       @default(0)
  perUserLimit    Int?      @default(1)

  // Geçerlilik
  validFrom       DateTime
  validUntil      DateTime?

  // Kısıtlamalar
  applicableCategories String[]
  applicableProducts   String[]
  excludedCategories   String[]
  excludedProducts     String[]

  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders          Order[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([code])
  @@index([isActive])
  @@index([validFrom])
  @@index([validUntil])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

// ============================================
// REVIEWS & RATINGS
// ============================================

// Ürün Yorumları
model Review {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating      Int       // 1-5
  title       String?
  comment     String?

  // Yardımcı oldu mu?
  helpfulCount Int      @default(0)
  notHelpfulCount Int   @default(0)

  // Onay ve moderasyon
  isApproved  Boolean   @default(false)
  isVerifiedPurchase Boolean @default(false)
  moderatorNotes String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@index([rating])
}

// ============================================
// PURCHASE REQUESTS & APPROVALS
// ============================================

// Satın Alma Talebi
model PurchaseRequest {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])

  requestNumber   String
  requesterId     String
  requester       User                @relation(fields: [requesterId], references: [id])
  departmentId    String
  department      Department          @relation(fields: [departmentId], references: [id])

  // Satın alım kategorisi
  purchaseCategoryId String?
  purchaseCategory   PurchaseCategory? @relation(fields: [purchaseCategoryId], references: [id])

  title           String
  description     String?
  priority        RequestPriority     @default(NORMAL)
  status          RequestStatus       @default(DRAFT)

  estimatedTotal  Decimal             @db.Decimal(12, 2)
  actualTotal     Decimal?            @db.Decimal(12, 2)

  requiredDate    DateTime?
  approvedDate    DateTime?
  completedDate   DateTime?

  currentStep     Int                 @default(0)
  workflowId      String?
  workflow        ApprovalWorkflow?   @relation(fields: [workflowId], references: [id])

  orderId         String?             @unique
  order           Order?              @relation(fields: [orderId], references: [id])

  items           PurchaseRequestItem[]
  approvalActions ApprovalAction[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([companyId, requestNumber])
  @@index([companyId])
  @@index([requestNumber])
  @@index([requesterId])
  @@index([departmentId])
  @@index([purchaseCategoryId])
  @@index([status])
  @@index([priority])
}

// Satın Alma Talep Ürünleri
model PurchaseRequestItem {
  id                String          @id @default(cuid())
  requestId         String
  request           PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id])

  productName       String
  productSku        String?
  quantity          Int
  unitPrice         Decimal         @db.Decimal(10, 2)
  totalPrice        Decimal         @db.Decimal(10, 2)
  notes             String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([requestId])
  @@index([productId])
}

// Onay İş Akışı Tanımları
model ApprovalWorkflow {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  isActive        Boolean       @default(true)

  minAmount       Decimal?      @db.Decimal(12, 2)
  maxAmount       Decimal?      @db.Decimal(12, 2)
  departmentIds   String[]

  steps           ApprovalStep[]
  purchaseRequests PurchaseRequest[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([companyId])
  @@index([isActive])
}

// Onay Adımları
model ApprovalStep {
  id              String              @id @default(cuid())
  workflowId      String
  workflow        ApprovalWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  stepOrder       Int
  stepName        String
  approverRole    UserRole?
  approverId      String?
  requiredAction  StepAction          @default(APPROVE)
  isOptional      Boolean             @default(false)
  isParallel      Boolean             @default(false)
  timeoutHours    Int?                // Otomatik onay/red için süre

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([workflowId, stepOrder])
  @@index([workflowId])
}

// Onay Aksiyonları
model ApprovalAction {
  id              String          @id @default(cuid())
  requestId       String
  request         PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  stepOrder       Int
  approverId      String
  approver        User            @relation(fields: [approverId], references: [id])

  action          ActionType
  comments        String?
  attachments     String[]

  actionDate      DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([requestId])
  @@index([approverId])
  @@index([action])
}

// ============================================
// SUPPLIERS
// ============================================

// Tedarikçi Modeli
model Supplier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name          String
  code          String?
  contactPerson String?
  email         String
  phone         String?
  fax           String?
  website       String?

  // Adres
  address       String?
  city          String?
  district      String?
  postalCode    String?
  country       String?   @default("Türkiye")

  // Vergi bilgileri
  taxNumber     String?
  taxOffice     String?

  // Performans
  rating        Float?   @default(0)
  totalOrders   Int      @default(0)
  onTimeDeliveryRate Decimal? @db.Decimal(5, 2)
  status        SupplierStatus @default(ACTIVE)

  // Ödeme koşulları
  paymentTerms  String?  // 30 gün, peşin, vs.
  currency      String?  @default("TRY")

  // Notlar
  notes         String?
  internalNotes String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  documents     Document[]

  @@unique([companyId, email])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@index([email])
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
}

// ============================================
// ADDRESS MANAGEMENT
// ============================================

model Address {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String    // Ev, İş, vs.
  type        AddressType @default(OTHER)

  fullName    String
  phone       String
  email       String?

  addressLine1 String
  addressLine2 String?
  district    String
  city        String
  state       String?
  postalCode  String?
  country     String    @default("Türkiye")

  latitude    Decimal?  @db.Decimal(10, 8)
  longitude   Decimal?  @db.Decimal(11, 8)

  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  billingOrders   Order[] @relation("BillingAddress")
  shippingOrders  Order[] @relation("ShippingAddress")

  @@index([companyId])
  @@index([userId])
  @@index([isDefault])
}

enum AddressType {
  HOME
  WORK
  BILLING
  SHIPPING
  OTHER
}

// ============================================
// DOCUMENTS & FILES
// ============================================

model Document {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  uploadedBy  String
  uploader    User      @relation(fields: [uploadedBy], references: [id])

  name        String
  originalName String
  mimeType    String
  size        Int       // bytes
  path        String
  url         String?

  category    DocumentCategory @default(OTHER)

  // İlişkiler
  relatedType String?   // Product, Supplier, Order, vs.
  relatedId   String?

  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])

  description String?
  tags        String[]

  isPublic    Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([uploadedBy])
  @@index([category])
  @@index([relatedType, relatedId])
}

enum DocumentCategory {
  INVOICE
  RECEIPT
  CONTRACT
  CERTIFICATE
  PRODUCT_IMAGE
  PRODUCT_DOCUMENT
  OTHER
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String

  // İlişki
  relatedType String?   // Order, PurchaseRequest, etc.
  relatedId   String?

  // Durum
  isRead      Boolean   @default(false)
  readAt      DateTime?

  // Kanal
  channels    NotificationChannel[]

  // Data
  data        Json?

  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@index([recipientId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

enum NotificationType {
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PURCHASE_REQUEST_CREATED
  PURCHASE_REQUEST_APPROVED
  PURCHASE_REQUEST_REJECTED
  APPROVAL_REQUIRED
  LOW_STOCK
  BUDGET_ALERT
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  SYSTEM_ALERT
  GENERAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

// ============================================
// ACTIVITY LOG & AUDIT TRAIL
// ============================================

model ActivityLog {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      String    // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity      String    // User, Product, Order, etc.
  entityId    String?

  // Değişiklik detayları
  changes     Json?
  oldValues   Json?
  newValues   Json?

  // Context
  ipAddress   String?
  userAgent   String?
  method      String?   // GET, POST, PUT, DELETE
  path        String?

  description String?

  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// SETTINGS
// ============================================

// Site Ayarları
model Setting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  type        String    @default("text")
  group       String    @default("general")
  description String?
  isPublic    Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([key])
  @@index([group])
}

// ============================================
// ENUMS
// ============================================

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  ON_HOLD
}

enum StepAction {
  APPROVE
  REVIEW
  VERIFY
  SIGN
}

enum ActionType {
  APPROVED
  REJECTED
  RETURNED
  COMMENTED
  ESCALATED
}
