// Attelia Dental Multi-Tenant E-commerce Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Şirket/Organizasyon Modeli (Multi-tenant)
model Company {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  taxNumber     String?   @unique
  address       String?
  city          String?
  phone         String?
  email         String?
  website       String?
  logo          String?
  isActive      Boolean   @default(true)
  settings      Json?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users         User[]
  departments   Department[]
  categories    Category[]
  products      Product[]
  orders        Order[]
  purchaseRequests PurchaseRequest[]
  workflows     ApprovalWorkflow[]
  companyBudgets CompanyBudget[]
  purchaseCategories PurchaseCategory[]
  suppliers     Supplier[]
  notificationTemplates NotificationTemplate[]
  companySettings CompanySettings?

  @@index([slug])
}

// Kullanıcı Modeli
model User {
  id            String    @id @default(cuid())
  email         String
  name          String
  password      String
  phone         String?
  role          UserRole  @default(EMPLOYEE)

  // Multi-tenant
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Departman bilgileri
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  position      String?
  employeeId    String?

  address       String?
  city          String?
  district      String?
  postalCode    String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders              Order[]
  cart                CartItem[]
  reviews             Review[]
  purchaseRequests    PurchaseRequest[]
  approvalActions     ApprovalAction[]
  managedDepartments  Department[] @relation("DepartmentManager")
  userBudgets         UserBudget[]

  @@unique([email, companyId])
  @@index([email])
  @@index([companyId])
  @@index([departmentId])
  @@index([employeeId])
}

enum UserRole {
  SUPER_ADMIN        // Platform admin
  COMPANY_ADMIN      // Şirket admin'i
  EMPLOYEE
  DEPARTMENT_MANAGER
  FINANCE_MANAGER
  GENERAL_MANAGER
  PROCUREMENT_MANAGER
}

// Departman Modeli
model Department {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String
  code            String
  description     String?
  managerId       String?
  manager         User?     @relation("DepartmentManager", fields: [managerId], references: [id])
  parentId        String?
  parent          Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children        Department[] @relation("DepartmentHierarchy")

  monthlyBudget   Decimal?  @db.Decimal(12, 2)
  yearlyBudget    Decimal?  @db.Decimal(12, 2)

  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employees           User[]
  purchaseRequests    PurchaseRequest[]
  budgets             Budget[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([code])
  @@index([managerId])
}

// Bütçe Yönetimi - Departman Bazlı
model Budget {
  id              String      @id @default(cuid())
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  year            Int
  month           Int?
  amount          Decimal     @db.Decimal(12, 2)
  spent           Decimal     @db.Decimal(12, 2) @default(0)
  reserved        Decimal     @db.Decimal(12, 2) @default(0)
  notes           String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([departmentId, year, month])
  @@index([departmentId])
  @@index([year])
}

// Şirket Bazlı Bütçe
model CompanyBudget {
  id              String      @id @default(cuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year            Int
  month           Int?
  amount          Decimal     @db.Decimal(12, 2)
  spent           Decimal     @db.Decimal(12, 2) @default(0)
  reserved        Decimal     @db.Decimal(12, 2) @default(0)
  notes           String?
  category        String?     // Genel, IT, Operasyonel, vs.

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([companyId, year, month, category])
  @@index([companyId])
  @@index([year])
}

// Kullanıcı/Kişi Bazlı Bütçe
model UserBudget {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  year            Int
  month           Int?
  amount          Decimal     @db.Decimal(12, 2)
  spent           Decimal     @db.Decimal(12, 2) @default(0)
  reserved        Decimal     @db.Decimal(12, 2) @default(0)
  notes           String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, year, month])
  @@index([userId])
  @@index([year])
}

// Satın Alım Kategori Tanımlamaları (Hiyerarşik)
model PurchaseCategory {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String
  code            String
  description     String?
  parentId        String?
  parent          PurchaseCategory?   @relation("PurchaseCategoryHierarchy", fields: [parentId], references: [id])
  children        PurchaseCategory[]  @relation("PurchaseCategoryHierarchy")

  // Bütçe limitleri
  monthlyLimit    Decimal?            @db.Decimal(12, 2)
  yearlyLimit     Decimal?            @db.Decimal(12, 2)

  // Onay gereksinimleri
  requiresApproval Boolean            @default(true)
  minApprovalAmount Decimal?          @db.Decimal(12, 2)

  isActive        Boolean             @default(true)
  order           Int                 @default(0)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  purchaseRequests PurchaseRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([code])
  @@index([parentId])
}

// Kategori Modeli
model Category {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  image       String?
  parentId    String?
  parent      Category? @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]
  order       Int       @default(0)
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([slug])
  @@index([parentId])
}

// Ürün Modeli
model Product {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String
  slug            String
  description     String?
  shortDesc       String?
  sku             String
  barcode         String?
  price           Decimal       @db.Decimal(10, 2)
  discountPrice   Decimal?      @db.Decimal(10, 2)
  wholesalePrice  Decimal?      @db.Decimal(10, 2)
  minOrderQty     Int           @default(1)
  stock           Int           @default(0)
  unit            String        @default("adet")
  weight          Decimal?      @db.Decimal(10, 2)
  dimensions      String?
  images          String[]

  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])

  supplierId      String?
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])

  brand           String?
  manufacturer    String?
  tags            String[]
  isActive        Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  isNew           Boolean       @default(false)
  viewCount       Int           @default(0)
  salesCount      Int           @default(0)
  rating          Decimal?      @db.Decimal(3, 2)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  cartItems             CartItem[]
  orderItems            OrderItem[]
  reviews               Review[]
  purchaseRequestItems  PurchaseRequestItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([supplierId])
  @@index([isActive])
}

// Sepet Modeli
model CartItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

// Sipariş Modeli
model Order {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])

  orderNumber     String
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING)

  billingName     String
  billingEmail    String
  billingPhone    String
  billingAddress  String
  billingCity     String
  billingDistrict String
  billingPostal   String?

  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingDistrict String
  shippingPostal  String?

  subtotal        Decimal       @db.Decimal(10, 2)
  shippingCost    Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  discount        Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)

  paymentMethod   String
  paymentStatus   PaymentStatus @default(PENDING)

  notes           String?
  trackingNumber  String?

  items             OrderItem[]
  purchaseRequest   PurchaseRequest?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([orderNumber])
  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Sipariş Ürün Modeli
model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  productName String
  productSku  String
  quantity    Int
  price       Decimal   @db.Decimal(10, 2)
  total       Decimal   @db.Decimal(10, 2)

  @@index([orderId])
}

// Ürün Yorumları
model Review {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  isApproved  Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId])
  @@index([userId])
}

// Satın Alma Talebi
model PurchaseRequest {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])

  requestNumber   String
  requesterId     String
  requester       User                @relation(fields: [requesterId], references: [id])
  departmentId    String
  department      Department          @relation(fields: [departmentId], references: [id])

  // Satın alım kategorisi
  purchaseCategoryId String?
  purchaseCategory   PurchaseCategory? @relation(fields: [purchaseCategoryId], references: [id])

  title           String
  description     String?
  priority        RequestPriority     @default(NORMAL)
  status          RequestStatus       @default(DRAFT)

  estimatedTotal  Decimal             @db.Decimal(12, 2)
  actualTotal     Decimal?            @db.Decimal(12, 2)

  requiredDate    DateTime?

  currentStep     Int                 @default(0)
  workflowId      String?
  workflow        ApprovalWorkflow?   @relation(fields: [workflowId], references: [id])

  orderId         String?             @unique
  order           Order?              @relation(fields: [orderId], references: [id])

  items           PurchaseRequestItem[]
  approvalActions ApprovalAction[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([companyId, requestNumber])
  @@index([companyId])
  @@index([requestNumber])
  @@index([requesterId])
  @@index([departmentId])
  @@index([purchaseCategoryId])
  @@index([status])
}

// Satın Alma Talep Ürünleri
model PurchaseRequestItem {
  id                String          @id @default(cuid())
  requestId         String
  request           PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id])

  productName       String
  productSku        String?
  quantity          Int
  unitPrice         Decimal         @db.Decimal(10, 2)
  totalPrice        Decimal         @db.Decimal(10, 2)
  notes             String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([requestId])
  @@index([productId])
}

// Onay İş Akışı Tanımları
model ApprovalWorkflow {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  isActive        Boolean       @default(true)

  minAmount       Decimal?      @db.Decimal(12, 2)
  maxAmount       Decimal?      @db.Decimal(12, 2)
  departmentIds   String[]

  steps           ApprovalStep[]
  purchaseRequests PurchaseRequest[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([companyId])
  @@index([isActive])
}

// Onay Adımları
model ApprovalStep {
  id              String              @id @default(cuid())
  workflowId      String
  workflow        ApprovalWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  stepOrder       Int
  stepName        String
  approverRole    UserRole?
  approverId      String?
  requiredAction  StepAction          @default(APPROVE)
  isOptional      Boolean             @default(false)
  isParallel      Boolean             @default(false)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([workflowId, stepOrder])
  @@index([workflowId])
}

// Onay Aksiyonları
model ApprovalAction {
  id              String          @id @default(cuid())
  requestId       String
  request         PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  stepOrder       Int
  approverId      String
  approver        User            @relation(fields: [approverId], references: [id])

  action          ActionType
  comments        String?

  actionDate      DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([requestId])
  @@index([approverId])
}

// Site Ayarları
model Setting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  type        String    @default("text")
  group       String    @default("general")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([key])
  @@index([group])
}

// Enums
enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum StepAction {
  APPROVE
  REVIEW
  VERIFY
}

enum ActionType {
  APPROVED
  REJECTED
  RETURNED
  COMMENTED
}

// Tedarikçi Modeli
model Supplier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name          String
  contactPerson String?
  email         String
  phone         String?
  address       String?
  city          String?
  taxNumber     String?

  rating        Float?   @default(0)
  totalOrders   Int      @default(0)
  status        SupplierStatus @default(ACTIVE)

  notes         String?
  website       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([status])
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ============================================
// NOTIFICATION SYSTEM
// ============================================

// Notification Templates (Email, SMS, WhatsApp, etc.)
model NotificationTemplate {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String   // "purchase_request_submitted"
  displayName     String   // "Satın Alma Talebi Oluşturuldu"
  channel         NotificationChannel @default(EMAIL)
  category        NotificationCategory @default(TRANSACTIONAL)

  subject         String?  // Email subject (with {{variables}})
  body            String   // Template body with {{variables}}

  isActive        Boolean  @default(true)
  isSystem        Boolean  @default(false) // System templates cannot be deleted

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  logs            NotificationLog[]

  @@unique([companyId, name, channel])
  @@index([companyId])
  @@index([channel])
  @@index([isActive])
}

// Notification Delivery Logs
model NotificationLog {
  id              String   @id @default(cuid())
  companyId       String

  templateId      String?
  template        NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  userId          String?  // Recipient user (if registered)
  channel         NotificationChannel
  status          NotificationStatus @default(PENDING)

  recipient       String   // Email address, phone number, etc.
  subject         String?
  body            String

  metadata        Json?    // Additional data (request ID, etc.)
  errorMessage    String?

  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
  PUSH
}

enum NotificationCategory {
  TRANSACTIONAL  // Approval requests, order confirmations
  MARKETING      // Promotional emails
  SYSTEM         // System alerts, maintenance
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  READ
}

// ============================================
// COMPANY SETTINGS (WHITE-LABEL)
// ============================================

// Company Branding & Theme Settings
model CompanySettings {
  id              String   @id @default(cuid())
  companyId       String   @unique
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Branding
  logoUrl         String?
  faviconUrl      String?

  // Theme Colors
  primaryColor    String   @default("#0070f3")
  secondaryColor  String   @default("#0051cc")
  accentColor     String   @default("#ea580c")
  successColor    String   @default("#059669")
  warningColor    String   @default("#eab308")
  errorColor      String   @default("#dc2626")

  // Typography
  fontFamily      String   @default("Inter")

  // Layout Colors
  sidebarBgColor  String   @default("#ffffff")
  sidebarTextColor String  @default("#374151")
  headerBgColor   String   @default("#0070f3")
  headerTextColor String   @default("#ffffff")

  // Advanced
  customCSS       String?  @db.Text  // Sanitized custom CSS
  customJS        String?  @db.Text  // Sandboxed custom JavaScript

  // Features
  enableDarkMode  Boolean  @default(false)
  enableCustomFonts Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
}
