// Attelia Dental E-commerce Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kullanıcı Modeli
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  phone         String?
  role          UserRole  @default(CUSTOMER)
  companyName   String?
  taxNumber     String?
  address       String?
  city          String?
  district      String?
  postalCode    String?

  // Departman bilgileri
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  position      String?
  employeeId    String?     @unique

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders              Order[]
  cart                CartItem[]
  reviews             Review[]
  purchaseRequests    PurchaseRequest[]
  approvalActions     ApprovalAction[]
  managedDepartments  Department[] @relation("DepartmentManager")

  @@index([email])
  @@index([departmentId])
  @@index([employeeId])
}

enum UserRole {
  ADMIN
  CUSTOMER
  DEALER
  EMPLOYEE
  DEPARTMENT_MANAGER
  FINANCE_MANAGER
  GENERAL_MANAGER
}

// Kategori Modeli
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  parentId    String?
  parent      Category? @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([parentId])
}

// Ürün Modeli
model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?
  shortDesc       String?
  sku             String        @unique
  barcode         String?
  price           Decimal       @db.Decimal(10, 2)
  discountPrice   Decimal?      @db.Decimal(10, 2)
  wholesalePrice  Decimal?      @db.Decimal(10, 2)
  minOrderQty     Int           @default(1)
  stock           Int           @default(0)
  unit            String        @default("adet")
  weight          Decimal?      @db.Decimal(10, 2)
  dimensions      String?
  images          String[]
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  brand           String?
  manufacturer    String?
  tags            String[]
  isActive        Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  isNew           Boolean       @default(false)
  viewCount       Int           @default(0)
  salesCount      Int           @default(0)
  rating          Decimal?      @db.Decimal(3, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  cartItems             CartItem[]
  orderItems            OrderItem[]
  reviews               Review[]
  purchaseRequestItems  PurchaseRequestItem[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
}

// Sepet Modeli
model CartItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

// Sipariş Modeli
model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING)

  // Fatura Bilgileri
  billingName     String
  billingEmail    String
  billingPhone    String
  billingAddress  String
  billingCity     String
  billingDistrict String
  billingPostal   String?

  // Teslimat Bilgileri
  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingDistrict String
  shippingPostal  String?

  // Fiyat Bilgileri
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingCost    Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  discount        Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)

  paymentMethod   String
  paymentStatus   PaymentStatus @default(PENDING)

  notes           String?
  trackingNumber  String?

  items             OrderItem[]
  purchaseRequest   PurchaseRequest?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Sipariş Ürün Modeli
model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  productName String
  productSku  String
  quantity    Int
  price       Decimal   @db.Decimal(10, 2)
  total       Decimal   @db.Decimal(10, 2)

  @@index([orderId])
}

// Ürün Yorumları
model Review {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  isApproved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId])
  @@index([userId])
}

// Site Ayarları
model Setting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  type        String    @default("text")
  group       String    @default("general")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([key])
  @@index([group])
}

// Departman Modeli
model Department {
  id              String    @id @default(cuid())
  name            String
  code            String    @unique
  description     String?
  managerId       String?
  manager         User?     @relation("DepartmentManager", fields: [managerId], references: [id])
  parentId        String?
  parent          Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children        Department[] @relation("DepartmentHierarchy")

  // Bütçe bilgileri
  monthlyBudget   Decimal?  @db.Decimal(12, 2)
  yearlyBudget    Decimal?  @db.Decimal(12, 2)

  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employees           User[]
  purchaseRequests    PurchaseRequest[]
  budgets             Budget[]

  @@index([code])
  @@index([managerId])
  @@index([parentId])
}

// Bütçe Yönetimi
model Budget {
  id              String      @id @default(cuid())
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  year            Int
  month           Int?
  amount          Decimal     @db.Decimal(12, 2)
  spent           Decimal     @db.Decimal(12, 2) @default(0)
  reserved        Decimal     @db.Decimal(12, 2) @default(0)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([departmentId, year, month])
  @@index([departmentId])
  @@index([year])
}

// Satın Alma Talebi
model PurchaseRequest {
  id              String              @id @default(cuid())
  requestNumber   String              @unique
  requesterId     String
  requester       User                @relation(fields: [requesterId], references: [id])
  departmentId    String
  department      Department          @relation(fields: [departmentId], references: [id])

  title           String
  description     String?
  priority        RequestPriority     @default(NORMAL)
  status          RequestStatus       @default(DRAFT)

  // Talep tutarı
  estimatedTotal  Decimal             @db.Decimal(12, 2)
  actualTotal     Decimal?            @db.Decimal(12, 2)

  // İhtiyaç tarihi
  requiredDate    DateTime?

  // Onay bilgileri
  currentStep     Int                 @default(0)
  workflowId      String?
  workflow        ApprovalWorkflow?   @relation(fields: [workflowId], references: [id])

  // Sipariş ile ilişki
  orderId         String?             @unique
  order           Order?              @relation(fields: [orderId], references: [id])

  items           PurchaseRequestItem[]
  approvalActions ApprovalAction[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([requestNumber])
  @@index([requesterId])
  @@index([departmentId])
  @@index([status])
  @@index([workflowId])
}

// Satın Alma Talep Ürünleri
model PurchaseRequestItem {
  id                String          @id @default(cuid())
  requestId         String
  request           PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id])

  // Manuel ürün girişi için
  productName       String
  productSku        String?
  quantity          Int
  unitPrice         Decimal         @db.Decimal(10, 2)
  totalPrice        Decimal         @db.Decimal(10, 2)
  notes             String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([requestId])
  @@index([productId])
}

// Onay İş Akışı Tanımları
model ApprovalWorkflow {
  id              String        @id @default(cuid())
  name            String
  description     String?
  isActive        Boolean       @default(true)

  // Koşullar
  minAmount       Decimal?      @db.Decimal(12, 2)
  maxAmount       Decimal?      @db.Decimal(12, 2)
  departmentIds   String[]      // Hangi departmanlar için geçerli

  steps           ApprovalStep[]
  purchaseRequests PurchaseRequest[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([isActive])
}

// Onay Adımları
model ApprovalStep {
  id              String              @id @default(cuid())
  workflowId      String
  workflow        ApprovalWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  stepOrder       Int
  stepName        String
  approverRole    UserRole?
  approverId      String?             // Specific user or role
  requiredAction  StepAction          @default(APPROVE)
  isOptional      Boolean             @default(false)

  // Paralel onay (aynı anda birden fazla onaylayıcı)
  isParallel      Boolean             @default(false)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([workflowId, stepOrder])
  @@index([workflowId])
}

// Onay Aksiyonları
model ApprovalAction {
  id              String          @id @default(cuid())
  requestId       String
  request         PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  stepOrder       Int
  approverId      String
  approver        User            @relation(fields: [approverId], references: [id])

  action          ActionType
  comments        String?

  actionDate      DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([requestId])
  @@index([approverId])
}

// Enums
enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum StepAction {
  APPROVE
  REVIEW
  VERIFY
}

enum ActionType {
  APPROVED
  REJECTED
  RETURNED
  COMMENTED
}
